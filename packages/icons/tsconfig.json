{
  "compilerOptions": {
    "target": "ES2019",
    // `lib` outruns `target` on purpose: emit stays ES2019 for the shipped
    // bundle, while the checker knows about ES2020 APIs the Node-side tests use
    // (peer-deps.test.ts reads package.json with String.matchAll).
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    // `node` is for the tests only — no src file may import a Node builtin.
    "types": ["jest", "node"]
  },
  "include": ["src"]
}
