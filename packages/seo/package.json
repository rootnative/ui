{
  "name": "@rootnative/seo",
  "version": "0.0.0-alpha.23",
  "description": "Search-engine metadata for a React Native web export — head tags, JSON-LD builders, headings, HTML shell, sitemap, and robots.",
  "private": false,
  "sideEffects": false,
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "react-native": "dist/index.mjs",
  "source": "src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "react-native": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.mts",
      "react-native": "./dist/schema/index.mjs",
      "import": "./dist/schema/index.mjs",
      "default": "./dist/schema/index.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.mts",
      "react-native": "./dist/react/index.mjs",
      "import": "./dist/react/index.mjs",
      "default": "./dist/react/index.mjs"
    },
    "./expo-router": {
      "types": "./dist/expo-router/index.d.mts",
      "react-native": "./dist/expo-router/index.mjs",
      "import": "./dist/expo-router/index.mjs",
      "default": "./dist/expo-router/index.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs",
      "default": "./dist/node/index.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "schema": [
        "dist/schema/index.d.mts"
      ],
      "react": [
        "dist/react/index.d.mts"
      ],
      "expo-router": [
        "dist/expo-router/index.d.mts"
      ],
      "node": [
        "dist/node/index.d.mts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rootnative/ui.git",
    "directory": "packages/seo"
  },
  "homepage": "https://github.com/rootnative/ui",
  "keywords": [
    "react-native",
    "react-native-web",
    "expo-router",
    "seo",
    "open-graph",
    "json-ld",
    "sitemap"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "lint": "eslint . --max-warnings 0"
  },
  "peerDependencies": {
    "expo-router": ">=57.0.0",
    "react": ">=19.2.3 <20.0.0",
    "react-native": ">=0.83.0 <0.87.0"
  },
  "peerDependenciesMeta": {
    "expo-router": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.86.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "expo-router": "~57.0.19",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.0",
    "react-test-renderer": "19.2.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
